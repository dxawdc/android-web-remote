# Copy values into your process manager, shell, or an ignored .env file.
# The server does not automatically load this file.
PORT=8787
DATA_DIR=./data
JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_USERNAME=replace-with-initial-admin-name
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional mock device settings used by `npm run mock -w apps/server`.
WS_URL=ws://localhost:8787/ws
MOCK_DEVICE_ID=DEMO-PHONE
MOCK_ACCESS_KEY=replace-with-a-test-access-key
